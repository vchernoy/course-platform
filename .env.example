# Clerk (required for auth). Copy to `.env.local` and fill real values from the Clerk dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Draft storage: local (default) = `.data/drafts` on disk; blob = Vercel Blob (`BLOB_READ_WRITE_TOKEN`).
# DRAFT_BACKEND=local
# DRAFT_BACKEND=blob
# BLOB_READ_WRITE_TOKEN=

# Optional: explicit URLs (defaults usually work with `/sign-in` and `/sign-up` routes)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Set to false to hide the "Sign up" link on the home page (e.g. when sign-ups are disabled in Clerk).
# NEXT_PUBLIC_SHOW_SIGN_UP_LINK=false

# Cloudflare Stream iframe host (optional). Example: customer-xxxxxxxxxxxx.cloudflarestream.com
# If unset, VideoPlayer uses https://iframe.videodelivery.net/<playbackId>
# NEXT_PUBLIC_CLOUDFLARE_STREAM_CUSTOMER=customer-xxxxxxxxxxxx.cloudflarestream.com

# Private content repo (real users + private courses), cloned before `next build` — see docs/private-content.md
# PRIVATE_CONTENT_REPO=vchernoy/course-platform-private
# PRIVATE_CONTENT_TOKEN=github_pat_...   # fine-grained, Contents: read-only on that repo only
# PRIVATE_CONTENT_REF=main
# Local dev alternative: point at an existing checkout instead of cloning
# PRIVATE_CONTENT_DIR=../course-platform-private
